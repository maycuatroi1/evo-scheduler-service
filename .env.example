# ===== evo-scheduler-service - example environment =====
# Copy to .env and replace placeholder values. No real secrets here.

# Django / backend
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-real-secret-key
DATABASE_URL=postgres://scheduler:schedulerpassword@postgres:5432/scheduler

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT auth
JWT_SIGNING_KEY=replace-with-a-real-signing-key
JWT_ISSUER=
JWT_AUDIENCE=

# Frontend (baked in at build time, see docker-compose.prod.yml build args)
NEXT_PUBLIC_API_URL=http://localhost:8800/api
